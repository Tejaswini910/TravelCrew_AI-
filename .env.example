# Local Ollama does not require an API key.
OLLAMA_BASE_URL=https://your-secure-ollama-host
OLLAMA_MODEL=llama3.2
# Optional; only for a secured remote Ollama endpoint requiring authentication.
# OLLAMA_API_KEY=


# Keep false for fully offline planning. If enabled, search and weather may access the internet.
ENABLE_WEB_SEARCH=false
OLLAMA_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
